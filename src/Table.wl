serminus,
serplus,
zetalistList=Transpose[HurwitzZeta[-#,nmax+1+(\[CapitalDelta]list)/2]&/@(Range[-12,-(\[CapitalDelta]sermax-1),-1]-1+7-8N@\[CapitalDelta]\[Phi]N)],
Alist=AserCompiledList[l,\[CapitalDelta]list],
AAlist=AAListCompiled[l,\[CapitalDelta]list]*(Sin[\[Pi] (\[CapitalDelta]list/2-2 \[CapitalDelta]\[Phi]N)])^2
},
Alist=Alist*AAlist;
Table[
{serminus,serplus}=seriespairitem;
serconvoled=(seriesprodList[seriesprodList[mmat . serminus,pmat . serplus],normfacCompiled[\[CapitalDelta]\[Phi]N,Range[0,l,2]]]+seriesprodList[seriesprodList[pmat . serminus,mmat . serplus],normfac2Compiled[\[CapitalDelta]\[Phi]N,Range[0,l,2]]])*ZListCompiled[l];
Total/@(MapThread[Dot,{seriesprodList[serconvoled,Alist],zetalistList}](**AAlist*)),{seriespairitem,seriespair}]
];

asympspinlist[\[CapitalDelta]\[Phi]N_,seriespair_,spinlist_,\[CapitalDelta]max_,normed_:False,nmax_:100,halfstep_:101,\[CapitalDelta]sermax_:28]:=Block[{
pmatall=shiftmatrix[Range[0,Max[spinlist],2]/2,\[CapitalDelta]sermax],
mmatall=shiftmatrix[-Range[0,Max[spinlist],2]/2,\[CapitalDelta]sermax],
\[CapitalDelta]listall=Range[0,\[CapitalDelta]max,1/halfstep],
zetalistListall,
serconvoled,
pmat,
mmat,
serminus,
serplus,
zetalistList,
Alist,
\[CapitalDelta]list
},
zetalistListall=Transpose[HurwitzZeta[-#,nmax+1+(\[CapitalDelta]listall)/2]&/@(Range[-12,-(\[CapitalDelta]sermax-1),-1]-1+7-8N@\[CapitalDelta]\[Phi]N)];
Table[\[CapitalDelta]list=\[CapitalDelta]listall[[spanasympl[l,halfstep]]];
zetalistList=zetalistListall[[spanasympl[l,halfstep]]];
pmat=pmatall[[spanspinasympl[l]]];
mmat=mmatall[[spanspinasympl[l]]];
Alist=AserCompiledList[l,\[CapitalDelta]list]*(AAListCompiled[l,\[CapitalDelta]list]*(Sin[\[Pi] (\[CapitalDelta]list/2-2 \[CapitalDelta]\[Phi]N)])^2);
If[normed,Alist=4^(-\[CapitalDelta]list)*Alist];
Table[
{serminus,serplus}=seriespairitem;
serconvoled=(seriesprodList[seriesprodList[mmat . serminus,pmat . serplus],normfacCompiled[\[CapitalDelta]\[Phi]N,Range[0,l,2]]]+seriesprodList[seriesprodList[pmat . serminus,mmat . serplus],normfac2Compiled[\[CapitalDelta]\[Phi]N,Range[0,l,2]]])*ZListCompiled[l];
PadLeft[Total/@(MapThread[Dot,{seriesprodList[serconvoled,Alist],zetalistList}](**AAlist*)),Length@\[CapitalDelta]listall],{seriespairitem,seriespair}]
,{l,spinlist}]];


ClearAll[init3DTablePatch];
Options[init3DTablePatch]={"normed"->False,"fill"->30};
init3DTablePatch[lp1_,spinlist_,\[CapitalDelta]max_?IntegerQ,nmax_,OptionsPattern[]]:=Block[{
minus1=lp1["minus"]//Transpose[#,{3,1,2}]&,
plus1=lp1["plus"]//Transpose[#,{3,1,2}]&,
\[CapitalDelta]table1=lp1["\[CapitalDelta]table"],
step,
halfstep,
\[CapitalDelta]table2,
listPacked2d,
functablePacked,
dphi=2*lp1["dphi"],
funcnum=Length@functionallistCutOff[lp1["order"]],
seriespair,
normedInternal=Lookup[lp1,"normed",False]
},
minus1=Extract[minus1,functionallistCutOff[lp1["order"]][[All,1]]];
plus1=Extract[plus1,functionallistCutOff[lp1["order"]][[All,2]]];
step=(#[[2]]-#[[1]])^-1&@\[CapitalDelta]table1;
halfstep=step/2;
\[CapitalDelta]table2=(2*\[CapitalDelta]table1);
listPacked2d=Transpose@With[{spinlistFor2d=Range[0,Max[spinlist],2],chunkSize=30},
If[Length[spinlistFor2d]<=chunkSize,
func2dspin[spinlistFor2d,halfstep,\[CapitalDelta]table2,plus1,minus1],
Join@@(func2dspin[#,halfstep,\[CapitalDelta]table2,plus1,minus1]&/@Partition[spinlistFor2d,chunkSize,chunkSize,{1,1},{}])
]];
functablePacked=If[normedInternal,
func3dspinNormed[spinlist,nmax,halfstep,OptionValue["fill"],\[CapitalDelta]table2,listPacked2d],
func3dspin[spinlist,nmax,halfstep,OptionValue["fill"],\[CapitalDelta]table2,listPacked2d]
];
functablePacked=functablePacked[[All,All,;;\[CapitalDelta]max*halfstep+1]];
Print["Genereate 1d power series"];
seriespair=asymp2dfast[N[lp1["dphi"],50],lp1["order"]];
Print["Done"];
functablePacked=Transpose[functablePacked+asympspinlist[N[lp1["dphi"],50],seriespair,spinlist,\[CapitalDelta]max,normedInternal],{1,3,2}];
If[OptionValue["normed"],functablePacked=If[normedInternal,
normtoprodCompile3dPoly[spinlist,halfstep,dphi,\[CapitalDelta]table2[[;;\[CapitalDelta]max*halfstep+1]]],
normtoprodCompile3d[spinlist,halfstep,dphi,\[CapitalDelta]table2[[;;\[CapitalDelta]max*halfstep+1]]]
]*functablePacked];
Association[{"Dim"->3,"dphi"->dphi,"funcnum"->funcnum,"spinlist"->spinlist,"nmax"->nmax,"halfstep"->halfstep,"\[CapitalDelta]table"->\[CapitalDelta]table2[[;;\[CapitalDelta]max*halfstep+1]],"functablePacked"->functablePacked,"order"->lp1["order"],"prec"->lp1["prec"],"normed"->OptionValue["normed"]}]
];
init3DTablePatch[fileName_String,order_,spinlist_,\[CapitalDelta]max_?IntegerQ,nmax_,OptionsPattern[]]:=Block[{lp1=init1DTable[fileName,MachinePrecision,order,"normed"->True]},
init3DTablePatch[lp1,spinlist,\[CapitalDelta]max,nmax,"normed"->OptionValue["normed"],"fill"->OptionValue["fill"]]
];



Association[{"Dim"->3,"dphi"->dphi,"funcnum"->funcnum,"spinlist"->spinlist,"nmax"->nmax,"halfstep"->halfstep,"\[CapitalDelta]table"->\[CapitalDelta]table2,"functablePacked"->functablePacked,"order"->lp1["order"],"prec"->lp1["prec"]}]
];

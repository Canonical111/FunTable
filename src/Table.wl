(*initiate LP*)


section\[CapitalLambda][\[CapitalLambda]_,dphi_,halfstep_]:=halfstep*(4\[CapitalLambda]+6)+Floor[halfstep*2*dphi];

ClearAll[sectionPosList];

sectionPosList::usage="sectionPosList[dim_,\[CapitalLambda]_,dphi_,halfstep_,spinlist_,\[CapitalDelta]table2_,\[CapitalDelta]cutoff_:60,smallstep_:5,bigstep_:81] generate the index to extract for a LP problem. Make sure to truncate the packed table with the spinlist before the Extraction.";
sectionPosList::bound="The spin is too high to generate the index table.";
sectionPosList::ordered="The spinlist is not ordered.";
sectionPosList[dim_,\[CapitalLambda]_,dphi_,halfstep_,spinlist_,\[CapitalDelta]table2_,\[CapitalDelta]cutoff_:60,smallstep_:5,bigstep_:81]:=Block[{
smalllist,
largelist,
ind2join
},
(*If[\[CapitalDelta]cutoff*halfstep+Max[spinlist]*halfstep>Length[\[CapitalDelta]table2],Message[sectionPosList::bound];];*)
If[!OrderedQ[spinlist],Message[sectionPosList::ordered];Return@$Failed];
smalllist=If[dim==1||dim==2,Range[Length[\[CapitalDelta]table2]][[;;section\[CapitalLambda][\[CapitalLambda],dphi,halfstep];;smallstep]],Range[Length[\[CapitalDelta]table2]][[1+halfstep;;section\[CapitalLambda][\[CapitalLambda],dphi,halfstep];;smallstep]]];
largelist=Range[Length[\[CapitalDelta]table2]][[section\[CapitalLambda][\[CapitalLambda],dphi,halfstep]+1;;\[CapitalDelta]cutoff*halfstep+1;;bigstep]];
ind2join={{1,#}&/@Join[Rest@smalllist,largelist]}~Join~Table[{i,#}&/@Join[smalllist+spinlist[[i]]*halfstep,largelist+spinlist[[i]]*halfstep],{i,2,Length[spinlist]}];
DeleteCases[Join@@ind2join,x_/;x[[2]]>Length[\[CapitalDelta]table2]]//Developer`ToPackedArray
];

gapcostlist[lgap_,LList_,\[CapitalDelta]List_]:=Block[{
costlist=Table[0,Length@LList],
gappos=Flatten@Position[LList,lgap],
costlistsmall
},
costlistsmall=Power[10,-10*#]&/@((#-Min[#])&[\[CapitalDelta]List[[gappos]]]);
costlist[[gappos]]=costlistsmall/First[costlistsmall];
costlist
];

initLP[functionalTable_,lgap_,auxCost_:10^6, aux\[CapitalDelta]Lvalue_:-1,auxCutoff_:10^-10 ]:=Block[{
indlist,
vec\[CapitalDelta]List,
vecLList,
vecM,
veccostList,
targetList,

auxNum,
zeropos,
zeroNum,
targetListReg,

B\[CapitalDelta]List,
BLList,
bM,
Bcostlist,
solB,
invB,
functionalM,
effcostList,
negindlist
},
indlist=sectionPosList[functionalTable["Dim"],functionalTable["order"],functionalTable["dphi"],functionalTable["halfstep"],functionalTable["spinlist"],functionalTable["\[CapitalDelta]table"],50,5,81];
targetList=-functionalTable["functablePacked"][[1,1]];
auxNum=functionalTable["funcnum"];
vec\[CapitalDelta]List=Extract[functionalTable["\[CapitalDelta]table"],indlist[[All,{2}]]]//N;
vecLList=Extract[functionalTable["spinlist"],indlist[[All,{1}]]];
vecM=Transpose@Extract[functionalTable["functablePacked"],indlist];
veccostList=gapcostlist[lgap,vecLList,vec\[CapitalDelta]List];
zeropos=Position[targetList,x_/;Abs[x]<10^-2000]//Flatten;
zeroNum=Length[zeropos];
targetListReg=targetList;
targetListReg[[zeropos]]=N@Table[auxCutoff,zeroNum];
bM=DiagonalMatrix[targetListReg];
solB=Table[1.,auxNum];
Bcostlist=Table[auxCost,auxNum];
BLList=Table[aux\[CapitalDelta]Lvalue,auxNum];
B\[CapitalDelta]List=N@Table[aux\[CapitalDelta]Lvalue,auxNum];
invB=LinearSolve[bM]//Quiet;
functionalM=invB[vecM];
effcostList=veccostList-Bcostlist . functionalM;
negindlist=Pick[Range@Length@effcostList,UnitStep[effcostList],0];
Association[{"vec\[CapitalDelta]List"->vec\[CapitalDelta]List,
"vecLList"->vecLList,
"vecM"->vecM,
"veccostList"->veccostList,
"targetList"->targetList,
"auxNum"->auxNum,
"targetListReg"->targetListReg,
"B\[CapitalDelta]List"->B\[CapitalDelta]List,
"BLList"->BLList,
"bM"->bM,
"Bcostlist"->Bcostlist,
"solB"->solB,
"functionalM"->functionalM,
"effcostList"->effcostList,
"negindlist"->negindlist,
"Aux"->True,
"Reg"->True}]
];

init2DTable::usage="Initializes a convenient Association for a 2D table, either from provided data at a specified \[CapitalDelta]\[Phi] or from a file.
init2DTable[lp1_,spinlist_,OptionsPattern[]]
init2DTable[fileName_String, prec_,order_,spinlist_,OptionsPattern[]]
Options[init2DTable]={\"intp\"->False} specify whether generating the interpolation function.";
Options[init2DTable]={"intp"->False,"normed"->True};

SetAttributes[generateInterpolation,HoldAll];

Options[generateInterpolation]={"intporder"->8};

generateInterpolation[\[CapitalDelta]tablelist_,functablelist_,OptionsPattern[]]:=Module[{
},
ParallelTable[Interpolation[Transpose[{\[CapitalDelta]tablelist[[lind]],functablelist[[lind, funcind]]}],InterpolationOrder->OptionValue["intporder"]],{lind,Length@\[CapitalDelta]tablelist},{funcind,Length[functablelist[[1]]]}]
];

(*generateInterpolation[\[CapitalDelta]tablelist_,functablelist_,OptionsPattern[]]:=Module[{
},
ParallelTable[Table[Interpolation[Transpose[{\[CapitalDelta]tablelist[[lind]],functablelist[[lind,funcind]]}],InterpolationOrder->OptionValue["intporder"]],{funcind,Length[functablelist[[1]]]}],{lind,Length@\[CapitalDelta]tablelist}]
];*)

init2DTable[lp1_,spinlist_,OptionsPattern[]]:=Block[{
minus1=lp1["minus"]//Transpose[#,{3,1,2}]&,
plus1=lp1["plus"]//Transpose[#,{3,1,2}]&,
\[CapitalDelta]table1=lp1["\[CapitalDelta]table"],
step,
halfstep,
\[CapitalDelta]table2,
functablePacked,
\[CapitalDelta]tablelist,
\[CapitalDelta]tablelistN,
normed,
dphi=2*lp1["dphi"],
normedllist,
funcnum=Length@functionallistCutOff[lp1["order"]],
intpfuncList},
minus1=Extract[minus1,functionallistCutOff[lp1["order"]][[All,1]]];
plus1=Extract[plus1,functionallistCutOff[lp1["order"]][[All,2]]];
step=(#[[2]]-#[[1]])^-1&@\[CapitalDelta]table1;
halfstep=step/2;
\[CapitalDelta]table2=(2*\[CapitalDelta]table1);
functablePacked=Transpose[func2dspin[spinlist,halfstep,\[CapitalDelta]table2,plus1,minus1],{1,3,2}]; 

normed=normtoprodCompile[spinlist,halfstep,dphi,\[CapitalDelta]table2]*functablePacked; 

normedllist=Table[Transpose@normed[[i,spanl2d[2i-2,101]]],{i,Length@normed}];
\[CapitalDelta]tablelist=\[CapitalDelta]table2[[spanl2d[2#-2,halfstep]]]&/@Range[Length@spinlist];
\[CapitalDelta]tablelistN=N[\[CapitalDelta]tablelist];
If[OptionValue["intp"],
intpfuncList=generateInterpolation[\[CapitalDelta]tablelistN,normedllist];
(*ParallelEvaluate[ClearAll[normedllist]];*)
Association[{"Dim"->2,"dphi"->dphi,"funcnum"->funcnum,"spinlist"->spinlist,"halfstep"->halfstep,"normed"->OptionValue["normed"],"\[CapitalDelta]table"->\[CapitalDelta]table2,"\[CapitalDelta]tablelist"->\[CapitalDelta]tablelist,"functablePacked"->If[OptionValue["normed"],normed,functablePacked],"order"->lp1["order"],"prec"->lp1["prec"],"intp"->intpfuncList}],
Association[{"Dim"->2,"dphi"->dphi,"funcnum"->funcnum,"spinlist"->spinlist,"halfstep"->halfstep,"normed"->OptionValue["normed"],"\[CapitalDelta]table"->\[CapitalDelta]table2,"\[CapitalDelta]tablelist"->\[CapitalDelta]tablelist,"functablePacked"->If[OptionValue["normed"],normed,functablePacked],"order"->lp1["order"],"prec"->lp1["prec"]}]
]

];
init2DTable[fileName_String,order_,spinlist_,OptionsPattern[]]:=Block[{lp1=init1DTable[fileName,MachinePrecision,order]},
init2DTable[lp1,spinlist,"intp"->OptionValue["intp"],"normed"->OptionValue["normed"]]
];



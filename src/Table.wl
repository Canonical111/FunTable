(* ::Section::Closed:: *)
(*Compile Function load/save*)


libdir[]:="lib/";
If[!FileExistsQ["lib"],CreateDirectory["lib"]];

GetLibraryPostfix[]:=Module[{systemID},systemID=$SystemID;
Switch[systemID,
"Windows",".dll",
"MacOSX-x86-64",".dylib",
"MacOSX-ARM64",".dylib",
"Linux-x86-64",".so",
_,Throw["Unsupported system ID"]]];

compileLibraryLoc[func_]:=(libdir[]<>ToString[Unevaluated[func]]<>GetLibraryPostfix[]); 

compileMXLoc[func_]:=libdir[]<>ToString[Unevaluated[func]]<>"lib.mx";

saveCompile[func_]:= Block[{$funcLoc,$func},
$funcLoc=compileLibraryLoc[func];
$func=func;
CopyFile[$func[[-1,1]],$funcLoc,OverwriteTarget->True];
DumpSave[compileMXLoc[func],{$func,$funcLoc}];];

creatloadCompile[sym_,expr_]:=Block[{},If[FileExistsQ[compileMXLoc[sym]],Check[getCompile[sym],
DeleteFile[libdir[]<>ToString[Unevaluated[sym]]<>"lib.mx"];
DeleteFile[libdir[]<>ToString[Unevaluated[sym]]<>GetLibraryPostfix[]];
Print["Delete old lib "<>ToString[Unevaluated[sym]]];
sym=expr;saveCompile[sym];
]
,sym=expr;saveCompile[sym];];];

getCompile[func_]:=Block[{$func,$funcLoc},
Get[compileMXLoc[func]];
func=ReplacePart[$func,{-1,1}->$funcLoc];
];   

SetAttributes[{compileLibraryLoc,compileMXLoc,saveCompile,creatloadCompile,getCompile},HoldAll]; 



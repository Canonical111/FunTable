ClearAll[init1DTable,generate1DInterpolation];


init1DTable::usage="Initializes a convenient Association for a 1D table, either from provided data at a specified \[CapitalDelta]\[Phi] or from a file.
init1DTable[dphi_,\[CapitalDelta]table_,minus_,plus_,orderMax_,precMax_,prec_,order_,OptionsPattern[]]
init1DTable[fileName_String, prec_,order_,OptionsPattern[]]
Options[init1DTable]={\"intp\"->False} specify whether generating the interpolation function.";
Options[init1DTable]={"intp"->False,"highprec"->False,"normed"->False,"fileNormed"->False};


init1DTable::order="The order goal `1` is bigger than the maximal order `2`.";
init1DTable::prec="The precision goal `1` is bigger than the maximal precision `2`.";
init1DTable::denormwarn="De-normalizing a pre-normed file: 2^(2\[CapitalDelta]) factor can overflow at large \[CapitalDelta].";
init1DTable[dphi_,\[CapitalDelta]table_,minus_,plus_,orderMax_,precMax_,prec_,order_,OptionsPattern[]]:=Module[{setprec=SetPrecision[#,prec]&,minusorder,plusorder,intpfuncList,minusinttable,plusinttable,minusUse,plusUse},
If[order>orderMax,Message[init1DTable::order,order, orderMax];Return@$Failed];
If[prec>precMax,Message[init1DTable::prec,prec, precMax];Return@$Failed];
(* "normed" here means exp-only rescaling (factor 2^(-2\[CapitalDelta])): cancels the 4^\[CapitalDelta] growth of raw 1d functionals without introducing asymmetric polynomial factors that would break the 2d/3d product structure. *)
Which[
OptionValue["fileNormed"]&&!OptionValue["normed"],
Message[init1DTable::denormwarn];
minusUse=2^(2 \[CapitalDelta]table) minus;
plusUse=2^(2 \[CapitalDelta]table) plus,
!OptionValue["fileNormed"]&&OptionValue["normed"],
minusUse=2^(-2 \[CapitalDelta]table) minus;
plusUse=2^(-2 \[CapitalDelta]table) plus,
True,
minusUse=minus;plusUse=plus];
minusorder=minusUse[[All,All,;;order+1]];
plusorder=plusUse[[All,All,;;order+1]];

If[OptionValue["normed"],
minusinttable=minusUse;
plusinttable=plusUse;
Return@Association[{"Dim"->1,"dphi"->dphi,"\[CapitalDelta]table"->\[CapitalDelta]table,"minus"->setprec@minusinttable,"plus"->setprec@plusinttable,"minusHigh"->minusorder,"plusHigh"->plusorder,"order"->order,"prec"->prec,"precMax"->precMax,"normed"->True}]
];

If[OptionValue["intp"],
intpfuncList=generate1DInterpolation[dphi,\[CapitalDelta]table,minusorder,plusorder,prec,order];
Association[{"Dim"->1,"dphi"->dphi,"\[CapitalDelta]table"->\[CapitalDelta]table,"minus"->setprec@minusinttable,"plus"->setprec@plusinttable,"minusHigh"->minusorder,"plusHigh"->plusorder,"order"->order,"prec"->prec,"precMax"->precMax,"intp"->intpfuncList,"normed"->False}],
If[OptionValue["highprec"],
Association[{"Dim"->1,"dphi"->dphi,"\[CapitalDelta]table"->\[CapitalDelta]table,"minus"->setprec@minusorder,"plus"->setprec@plusorder,"minusHigh"->minusorder,"plusHigh"->plusorder,"order"->order,"prec"->prec,"precMax"->precMax,"normed"->False}],
Association[{"Dim"->1,"dphi"->dphi,"\[CapitalDelta]table"->\[CapitalDelta]table,"minus"->setprec@minusorder,"plus"->setprec@plusorder,"order"->order,"prec"->prec,"normed"->False}]]
]
];
init1DTable[fileName_String, prec_,order_,OptionsPattern[]]:=Block[{dphi,minus,orderMax,plus,precMax,\[CapitalDelta]table,normed=False},
Get[fileName];
init1DTable[dphi,\[CapitalDelta]table,minus,plus,orderMax,precMax,prec,order,"intp"->OptionValue["intp"],"highprec"->OptionValue["highprec"],"normed"->OptionValue["normed"],"fileNormed"->normed]
];

generate1DInterpolation[dphi_,\[CapitalDelta]table_,minus_,plus_,prec_,order_]:=Module[{
intporder=Floor[prec/2]+2,
setprec=SetPrecision[#,prec]&,
\[CapitalDelta]tableprec,
minusprec,
plusprec,
minusinttable,
plusinttable,
plusbetaflist,
plusalphaflist,
minusbetaflist,
minusalphaflist,
funcplusbeta,
funcplusalpha,
funcminusbeta,
funcminusalpha
},
\[CapitalDelta]tableprec=setprec[\[CapitalDelta]table];
minusprec=setprec[minus];
plusprec=setprec[plus];

minusinttable=2^(-2\[CapitalDelta]tableprec) (1+\[CapitalDelta]tableprec)^(4 dphi+3/2)*(minusprec);
plusinttable=2^(-2\[CapitalDelta]tableprec) (1+\[CapitalDelta]tableprec)^(4 dphi+7/2)*(plusprec);

plusbetaflist=Interpolation[Transpose[{\[CapitalDelta]tableprec,#}],InterpolationOrder->intporder]&/@(Transpose[plusinttable[[All,1]]]);
plusalphaflist=Interpolation[Transpose[{\[CapitalDelta]tableprec,#}],InterpolationOrder->intporder]&/@(Transpose[plusinttable[[All,2]]]);
minusbetaflist=Interpolation[Transpose[{\[CapitalDelta]tableprec,#}],InterpolationOrder->intporder]&/@(Transpose[minusinttable[[All,1]]]);minusalphaflist=Interpolation[Transpose[{\[CapitalDelta]tableprec,#}],InterpolationOrder->intporder]&/@(Transpose[minusinttable[[All,2]]]);

funcplusbeta=(Through@plusbetaflist[#])/(2^(-2#) (1+#)^(4 dphi+7/2))&;funcplusalpha=(Through@plusalphaflist[#])/(2^(-2#) (1+#)^(4 dphi+7/2))&;funcminusbeta=(Through@minusbetaflist[#])/(2^(-2#) (1+#)^(4 dphi+3/2))&;funcminusalpha=(Through@minusalphaflist[#])/(2^(-2#) (1+#)^(4 dphi+3/2))&;

{{funcminusbeta,funcminusalpha},{funcplusbeta,funcplusalpha}}
];



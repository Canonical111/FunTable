Cell["\<\
Large-\[CapitalDelta] asymptotic counterparts (bosonicminusAsymp, \
fermionicplusAsymp, in OneDAsymp.wl) are used by generate1ptmx above the \
threshold \[CapitalDelta] \[GreaterTilde] 2\[CapitalDelta]\[Phi] + 2m + 25. \
Special \[CapitalDelta]\[Phi]: 3/4 is handled in-source; 1/2 requires \
evaluating \[CapitalDelta]\[Phi] at SetPrecision[dphi,200] + 10^-30.\
\>", "Text",ExpressionUUID->"9392b244-19cc-483a-ad99-1c7c5313adc5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"listbeta", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"betaminus", "[", 
      RowBox[{"dphi", ",", "1", ",", "#", ",", 
